    "Your password is sent to your server once, to install an SSH key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Passwort wird einmal an Ihren Server gesendet, um einen SSH-Schlüssel zu installieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your password is sent to your server once, to install an SSH key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña se envía a tu servidor una vez para instalar una clave SSH."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe est envoyé une seule fois à votre serveur, pour installer une clé SSH."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password viene inviata al server una sola volta per installare una chiave SSH."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha é enviada ao servidor uma única vez para instalar uma chave SSH."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifreniz, SSH anahtarı yüklemek için sunucunuza yalnızca bir kez gönderilir."
          }
        }
      }
    },
    "Your password is used only once, for initial setup, and never stored." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Passwort wird nur ein einziges Mal für die Einrichtung verwendet und nie gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your password is used only once, for initial setup, and never stored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña se usa solo una vez, para la configuración inicial, y nunca se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe n'est utilisé qu'une seule fois, pour l'installation initiale, et n'est jamais stocké."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

    "Tap any metric to see its trend over the last 24 hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Metrik, um ihren Verlauf der letzten 24 Stunden zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap any metric to see its trend over the last 24 hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca cualquier métrica para ver su tendencia en las últimas 24 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez n'importe quel indicateur pour voir sa tendance sur les 24 dernières heures."
          }
        },
        "it" : {
          "stringUnit" : {

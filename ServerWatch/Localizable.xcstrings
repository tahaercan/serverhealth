    "iOS doesn't guarantee background scheduling — this is an approximate lower bound. In practice, checks happen close to this interval." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS garantiert keine Hintergrundplanung — dieser Wert ist eine ungefähre Untergrenze. In der Praxis erfolgen Prüfungen ungefähr in diesem Intervall."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS doesn't guarantee background scheduling — this is an approximate lower bound. In practice, checks happen close to this interval."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS no garantiza la programación en segundo plano — este valor es un límite inferior aproximado. En la práctica, las comprobaciones ocurren cerca de este intervalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ne garantit pas l'exécution en arrière-plan — il s'agit d'une borne inférieure approximative. En pratique, les vérifications ont lieu à un rythme proche de cet intervalle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS non garantisce la pianificazione in background — questo valore è un limite inferiore approssimativo. In pratica i controlli avvengono vicino a questo intervallo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS não garante o agendamento em segundo plano — este é um limite inferior aproximado. Na prática, as verificações ocorrem perto deste intervalo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS arka plan zamanlamasını garanti etmez — bu değer yaklaşık alt sınırdır. Pratikte kontroller bu süreye yakın aralıklarla yapılır."
          }
        }
      }
    },
    "iOS wakes the app every 15–30 minutes to run your checks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {

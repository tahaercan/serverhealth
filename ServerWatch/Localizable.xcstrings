    "\"System\" follows your device language and falls back to English if unsupported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System\" verwendet die Gerätesprache und fällt auf Englisch zurück, wenn diese nicht unterstützt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"System\" follows your device language and falls back to English if unsupported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Sistema» sigue el idioma del dispositivo y vuelve a inglés si no está soportado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Système » suit la langue de votre appareil et revient à l'anglais si elle n'est pas prise en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Sistema» segue la lingua del dispositivo e ricade sull'inglese se non supportata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Sistema\" segue o idioma do dispositivo e volta para inglês se não houver suporte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Sistem\" cihaz dilinizi takip eder; desteklenmiyorsa İngilizce'ye düşer."
          }
        }
      }
    },

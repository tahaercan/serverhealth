          }
        }
      }
    },
    "Tapping this connects to the server once with your password, installs a freshly-generated SSH key, then clears your password from memory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Tippen wird der Server einmal mit Ihrem Passwort kontaktiert, ein frisch erzeugter SSH-Schlüssel installiert und Ihr Passwort dann aus dem Speicher gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapping this connects to the server once with your password, installs a freshly-generated SSH key, then clears your password from memory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al pulsar, se conecta al servidor una vez con tu contraseña, instala una clave SSH recién generada y borra la contraseña de la memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toucher ce bouton connecte une fois au serveur avec votre mot de passe, installe une clé SSH fraîchement générée, puis efface le mot de passe de la mémoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toccando qui ci si connette al server una volta con la password, viene installata una nuova chiave SSH e la password viene cancellata dalla memoria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao tocar, conecta-se ao servidor uma vez com sua senha, instala uma chave SSH recém-gerada e em seguida apaga a senha da memória."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buna dokunduğunuzda sunucuya şifreyle bir kez bağlanılır, yeni üretilen bir SSH anahtarı kurulur ve ardından şifreniz bellekten silinir."
          }
        }
      }
    },
    "The SSH key is generated on this device and stays in your Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der SSH-Schlüssel wird auf diesem Gerät erzeugt und bleibt in deinem Schlüsselbund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The SSH key is generated on this device and stays in your Keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave SSH se genera en este dispositivo y permanece en tu llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé SSH est générée sur cet appareil et reste dans votre trousseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave SSH viene generata su questo dispositivo e resta nel Portachiavi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave SSH é gerada neste dispositivo e fica no seu Chaveiro."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH anahtarı bu cihazda oluşturulur ve Anahtar Zinciri'nde kalır."
          }
        }
      }
    },
    "This check needs vnstat on the server" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Prüfung benötigt vnstat auf dem Server"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This check needs vnstat on the server"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta comprobación requiere vnstat en el servidor"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette vérification nécessite vnstat sur le serveur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo controllo richiede vnstat sul server"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta verificação requer vnstat no servidor"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kontrol için sunucuda vnstat gerekli"
          }
        }
      }
    },
    "This server (%@) isn't apt-based. Please install vnstat and jq manually, then tap Save." : {
      "comment" : "A message that explains that the server is not apt-based, and that the user needs to install vnstat and jq manually.",
      "isCommentAutoGenerated" : true
    },
    "This server doesn't have vnstat installed. The rule will be saved but checks will fail until vnstat is set up. You can install it via the Server Requirements section above." : {
      "comment" : "A warning message displayed when a user tries to save a rule for a server that doesn't have vnstat installed.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Server ist vnstat nicht installiert. Die Regel wird gespeichert, aber Prüfungen schlagen fehl, bis vnstat eingerichtet ist. Du kannst es über den Abschnitt „Server-Anforderungen“ oben installieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server doesn't have vnstat installed. The rule will be saved but checks will fail until vnstat is set up. You can install it via the Server Requirements section above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor no tiene vnstat instalado. La regla se guardará, pero las comprobaciones fallarán hasta que se configure vnstat. Puedes instalarlo desde la sección «Requisitos del servidor» de arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur n'a pas vnstat installé. La règle sera enregistrée, mais les vérifications échoueront tant que vnstat n'est pas configuré. Vous pouvez l'installer via la section « Exigences du serveur » ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo server non ha vnstat installato. La regola verrà salvata, ma i controlli falliranno finché vnstat non sarà configurato. Puoi installarlo dalla sezione «Requisiti del server» qui sopra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor não tem vnstat instalado. A regra será salva, mas as verificações falharão até que o vnstat seja configurado. Você pode instalá-lo pela seção «Requisitos do servidor» acima."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucuda vnstat yüklü değil. Kural kaydedilecek ama vnstat kurulana kadar kontroller başarısız olacak. Yukarıdaki “Sunucu Gereksinimleri” bölümünden kurabilirsin."
          }
        }
      }
    },
    "This will remove %@, all its rules and history, and delete its SSH key from the Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden %@, alle Regeln und der Verlauf entfernt sowie der SSH-Schlüssel aus dem Schlüsselbund gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will remove %@, all its rules and history, and delete its SSH key from the Keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará %@, todas sus reglas e historial, y borrará su clave SSH del llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera supprimé, ainsi que toutes ses règles, son historique et sa clé SSH dans le trousseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno rimossi %@, tutte le sue regole e la cronologia, e la sua chiave SSH dal Portachiavi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso removerá %@, todas as suas regras e o histórico, e excluirá sua chave SSH do Chaveiro."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem %@ sunucusunu, tüm kurallarını ve geçmişini kaldırır; Anahtar Zinciri'ndeki SSH anahtarını da siler."
          }
        }
      }
    },

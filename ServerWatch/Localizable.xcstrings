    "Watch CPU, RAM, disk, bandwidth, services, Docker, security updates, and more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überwache CPU, RAM, Festplatte, Bandbreite, Dienste, Docker, Sicherheitsupdates und mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch CPU, RAM, disk, bandwidth, services, Docker, security updates, and more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observa CPU, RAM, disco, ancho de banda, servicios, Docker, actualizaciones de seguridad y más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveillez le CPU, la RAM, le disque, la bande passante, les services, Docker, les mises à jour de sécurité et bien plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitora CPU, RAM, disco, banda, servizi, Docker, aggiornamenti di sicurezza e altro ancora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe CPU, RAM, disco, largura de banda, serviços, Docker, atualizações de segurança e mais."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU, RAM, disk, bant genişliği, servisler, Docker, güvenlik güncellemeleri ve daha fazlasını izle."
          }
        }
      }
    },

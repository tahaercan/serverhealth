    "You can use {value} and {unit} as placeholders.\nExample: \"CPU spike: {value}{unit}\"" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können {value} und {unit} als Platzhalter verwenden.\nBeispiel: „CPU-Spitze: {value}{unit}\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can use {value} and {unit} as placeholders.\nExample: \"CPU spike: {value}{unit}\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes usar {value} y {unit} como marcadores.\nEjemplo: «Pico de CPU: {value}{unit}»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez utiliser {value} et {unit} comme variables.\nExemple : « Pic CPU : {value}{unit} »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi usare {value} e {unit} come segnaposto.\nEsempio: «Picco CPU: {value}{unit}»"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode usar {value} e {unit} como marcadores.\nExemplo: \"Pico de CPU: {value}{unit}\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{value} ve {unit} placeholder'larını kullanabilirsiniz.\nÖrnek: \"CPU yüklendi: {value}{unit}\""
          }
        }
      }
    },
    "You'll need the host, SSH user, and password. The password is used once to install a key, then forgotten." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst Host, SSH-Benutzer und Passwort. Das Passwort wird einmal verwendet, um einen Schlüssel zu installieren, und dann vergessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll need the host, SSH user, and password. The password is used once to install a key, then forgotten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitarás el host, el usuario SSH y la contraseña. La contraseña se usa una vez para instalar una clave y luego se olvida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous aurez besoin de l'hôte, de l'utilisateur SSH et du mot de passe. Le mot de passe sert une seule fois à installer une clé, puis il est oublié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avrai bisogno di host, utente SSH e password. La password viene usata una sola volta per installare una chiave, poi dimenticata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisará do host, do usuário SSH e da senha. A senha é usada uma vez para instalar uma chave, e depois é esquecida."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host, SSH kullanıcısı ve şifre gerekecek. Şifre bir kez anahtar kurmak için kullanılır, sonra unutulur."
          }
        }
      }
    },
    "Your data stays yours" : {
      "localizations" : {

          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha é usada apenas uma vez, para a configuração inicial, e nunca é armazenada."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şifren yalnızca ilk kurulum için bir kez kullanılır ve hiçbir yerde saklanmaz."
          }
        }
      }
    },

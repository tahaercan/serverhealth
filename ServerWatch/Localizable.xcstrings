      }
    },
    "Server Health is free and open source. You can audit every line of code, build it yourself, and contribute." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Health ist kostenlos und Open Source. Sie können jede Codezeile prüfen, es selbst kompilieren und mitwirken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Health is free and open source. You can audit every line of code, build it yourself, and contribute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Health es gratuito y de código abierto. Puedes auditar cada línea, compilarlo tú mismo y contribuir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Health est gratuit et open source. Vous pouvez auditer chaque ligne de code, le compiler vous-même et contribuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Health è gratuito e open source. Puoi controllare ogni riga di codice, compilarlo tu stesso e contribuire."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Health é gratuito e de código aberto. Você pode auditar cada linha do código, compilá-lo e contribuir."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Health ücretsiz ve açık kaynaktır. Tüm kodu inceleyebilir, kendiniz derleyebilir ve katkıda bulunabilirsiniz."
          }
        }
      }
    },
    "Server Health sends a local notification when a monitoring rule is triggered. iOS may run background checks every 15–30 minutes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Health sendet eine lokale Benachrichtigung, wenn eine Überwachungsregel ausgelöst wird. iOS führt Hintergrundprüfungen ca. alle 15–30 Minuten aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Health sends a local notification when a monitoring rule is triggered. iOS may run background checks every 15–30 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Health envía una notificación local cuando se activa una regla. iOS puede ejecutar comprobaciones en segundo plano cada 15–30 minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Health envoie une notification locale quand une règle est déclenchée. iOS peut exécuter les vérifications en arrière-plan toutes les 15 à 30 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server Health invia una notifica locale quando una regola viene attivata. iOS può eseguire i controlli in background ogni 15–30 minuti."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Server Health envia uma notificação local quando uma regra é acionada. O iOS pode executar verificações em segundo plano a cada 15–30 minutos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kural tetiklendiğinde Server Health yerel bir bildirim gönderir. iOS arka plan kontrolleri yaklaşık 15-30 dakikada bir çalıştırabilir."
          }
        }
      }
    },

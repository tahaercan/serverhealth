    "Only the display name changes. Host, port, user, and the SSH key stay the same. To change connection details, delete and re-add the server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ändert sich nur der Anzeigename. Host, Port, Benutzer und der SSH-Schlüssel bleiben gleich. Um die Verbindungsdaten zu ändern, lösche den Server und füge ihn neu hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the display name changes. Host, port, user, and the SSH key stay the same. To change connection details, delete and re-add the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cambia el nombre mostrado. El host, el puerto, el usuario y la clave SSH se mantienen. Para cambiar los datos de conexión, elimina y vuelve a añadir el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le nom affiché change. L'hôte, le port, l'utilisateur et la clé SSH restent identiques. Pour modifier les détails de connexion, supprimez et rajoutez le serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia solo il nome visualizzato. Host, porta, utente e chiave SSH restano invariati. Per modificare i dati di connessione, elimina e aggiungi nuovamente il server."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas o nome exibido muda. Host, porta, usuário e a chave SSH permanecem iguais. Para alterar os dados de conexão, exclua e adicione o servidor novamente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece görünen ad değişir. Host, port, kullanıcı adı ve SSH anahtarı aynı kalır. Bağlantı bilgilerini değiştirmek için sunucuyu silip yeniden ekle."
          }
        }
      }
    },

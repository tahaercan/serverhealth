    },
    "Glance at your servers — green if everything's OK, red when a rule is triggered." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Blick auf deine Server — grün, wenn alles OK ist, rot, wenn eine Regel ausgelöst wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glance at your servers — green if everything's OK, red when a rule is triggered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un vistazo a tus servidores: verde si todo está bien, rojo cuando se activa una regla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un coup d'œil à vos serveurs — vert si tout va bien, rouge quand une règle est déclenchée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno sguardo ai tuoi server — verde quando tutto è OK, rosso quando una regola viene attivata."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma olhada nos seus servidores — verde quando tudo está OK, vermelho quando uma regra é acionada."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucularına bir bakış — her şey yolundaysa yeşil, bir kural tetiklendiğinde kırmızı."
          }
        }
      }

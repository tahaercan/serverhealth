# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode user-specific state
xcuserdata/
*.xcuserstate
*.xcuserdatad/

# Build output — Archive + Export + IPA artifacts
build/
DerivedData/
*.xcarchive
*.ipa
*.app.dSYM/

# App Store screenshot working dir (uploaded directly to ASC, not part of repo)
screenshots/

# Swift Package Manager (resolved versions are tracked via Xcode's
# Package.resolved inside .xcodeproj — local checkouts/build are not)
.swiftpm/
.build/
Packages/
Package.pin
Package.resolved

# CocoaPods / Carthage / fastlane — not used by this project, but
# safe defaults in case anyone adds them later.
Pods/
Carthage/Build/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Misc
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
